# Investor Web — public vars (safe in browser bundles; RLS is the guard).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt-or-publishable-key>

# App origins — canonical/social metadata + cross-links.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# NEVER put SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL here.
