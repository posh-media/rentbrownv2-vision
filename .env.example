# Root env — scripts + migrations only. NEVER commit real values.
# App-level public env vars live in each app's own .env(.local) — see
# apps/web/.env.example, apps/admin/.env.example, apps/mobile/.env.example.

# Supabase project (Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-jwt-or-publishable-key>

# SERVER-ONLY — never expose to any client bundle or public env var.
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# Direct Postgres connection (pooler or direct) — migrations script only.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
WORKER_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres

# Bachs payment provider (Edge Function secrets — never in client bundles).
# sk_sandbox_* targets https://sandbox-api.bachs.io; sk_live_* targets
# https://api.bachs.io. The webhook signing secret is per-endpoint from the
# Bachs developer portal — it is NOT the API key.
BACHS_API_KEY=sk_sandbox_<key>
BACHS_WEBHOOK_SECRET=<endpoint-signing-secret>
# Optional hosted-checkout redirects (public https URLs; Bachs refuses localhost).
BACHS_SUCCESS_URL=
BACHS_CANCEL_URL=
