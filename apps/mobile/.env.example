# Investor Mobile — EXPO_PUBLIC_ vars are bundled into the app (safe to ship;
# authorization is enforced by RLS, never by the key).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt-or-publishable-key>

# NEVER put SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL here — they would ship
# inside the mobile bundle.
