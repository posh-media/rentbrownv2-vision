# Admin — public vars (safe in browser bundles; RLS + admin_roles is the guard).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-jwt-or-publishable-key>
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# NEVER put SUPABASE_SERVICE_ROLE_KEY or DATABASE_URL here.
